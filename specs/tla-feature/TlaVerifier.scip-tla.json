{
  "module": "specs/tla-feature/TlaVerifier.tla",
  "config": "specs/tla-feature/TlaVerifier.cfg",
  "variables": {
    "contractState": {
      "code": ["src/tla/model-contract.ts/LoadedTlaContract#contract"],
      "aliases": ["contract"]
    },
    "moduleState": {
      "code": ["src/tla/model-contract.ts/TlaModuleFacts#variables"],
      "aliases": ["moduleFacts", "variables", "operators"]
    },
    "conformanceState": {
      "code": ["src/tla/conformance.ts/TlaConformanceResult#findings"],
      "aliases": ["conformance", "findings"]
    },
    "toolState": {
      "code": ["src/tla/tool-runner.ts/TlaToolResult#status"],
      "aliases": ["checker", "status"]
    },
    "exitState": {
      "code": ["src/runtime/query-commands/tla.ts/TlaVerifyResult#exitCode"],
      "aliases": ["process.exitCode"]
    }
  },
  "actions": {
    "LoadContract": {
      "code": ["src/tla/model-contract.ts/loadTlaModelContract"],
      "reads": ["contractState"],
      "writes": ["contractState"]
    },
    "ReadModule": {
      "code": ["src/tla/model-contract.ts/readTlaModuleFacts"],
      "reads": ["contractState"],
      "writes": ["moduleState"],
      "waive": {
        "reads": ["contractState"],
        "reason": "runTlaVerify reads the loaded contract before calling readTlaModuleFacts"
      }
    },
    "CheckConformance": {
      "code": ["src/tla/conformance.ts/verifyTlaConformance"],
      "reads": ["contractState", "moduleState", "conformanceState"],
      "writes": ["conformanceState"]
    },
    "RunChecker": {
      "code": ["src/tla/tool-runner.ts/runTlaTool"],
      "reads": ["conformanceState", "toolState"],
      "writes": ["toolState"],
      "waive": {
        "reads": ["conformanceState"],
        "reason": "runTlaVerify gates runTlaTool after conformance rather than runTlaTool reading the result"
      }
    },
    "DecideExit": {
      "code": ["src/runtime/query-commands/tla.ts/exitCodeFor"],
      "reads": ["conformanceState", "toolState"],
      "writes": ["exitState"],
      "waive": {
        "writes": ["exitState"],
        "reason": "exitCodeFor returns a code; runTlaVerify writes process.exitCode"
      }
    }
  },
  "invariants": ["TypeOK", "ModuleAfterContract", "CheckerAfterConformance", "ExitAfterEvidence"],
  "traces": ["specs/tla-feature/TlaVerifier.trace.json"]
}
