  "declaredCouplings": [
    {
      "name": "generated command surface",
      "reason": "The CLI descriptors, generated command reference, primary skill, query export manifest, and package exports describe one public command and query surface.",
      "files": [
        "docs/COMMAND_REFERENCE.md",
        "skills/scip-query/SKILL.md",
        "scripts/render-command-reference.ts",
        "src/runtime/commands/command-descriptors.ts",
        "src/queries/public-query-entries.ts",
        "src/queries/index.ts",
        "package.json"
      ]
    },
    {
      "name": "docs truth pass family",
      "reason": "The README, failure-mode guide, and detector guide explain the same product boundary and detector semantics.",
      "files": ["README.md", "docs/AI_FAILURE_MODES.md", "docs/DETECTOR_GUIDE.md"]
    },
    {
      "name": "cleanup detector family",
      "reason": "These query files implement the cleanup and maintainability detectors that share candidate, evidence, and health policy changes.",
      "files": [
        "src/queries/quality/complexity-hotspots.ts",
        "src/queries/cleanup/dead.ts",
        "src/queries/cleanup/drift.ts",
        "src/queries/cleanup/extract-candidates.ts",
        "src/queries/cleanup/isolated.ts",
        "src/queries/cleanup/passthrough-candidates.ts",
        "src/queries/cleanup/redundant-reexports.ts",
        "src/queries/cleanup/similar.ts",
        "src/queries/cleanup/stale-abstractions.ts",
        "src/queries/cleanup/wrapper-candidates.ts"
      ]
    },
    {
      "name": "graph summary query family",
      "reason": "These query files report related fan-in, fan-out, hotspot, and bottleneck graph summaries.",
      "files": ["src/queries/graph/bottlenecks.ts", "src/queries/graph/fan.ts", "src/queries/graph/hotspots.ts"]
    },
    {
      "name": "reference navigation query family",
      "reason": "These query files expose nearby views of definition and reference navigation.",
      "files": ["src/queries/navigation/refs.ts", "src/queries/navigation/trace.ts"]
    },
    {
      "name": "package build surface",
      "reason": "Package metadata and bundle entrypoints intentionally move together when the published CLI surface changes.",
      "files": ["package.json", "tsup.config.ts"]
    },
    {
      "name": "runtime command dispatch",
      "reason": "Command descriptors and command execution intentionally move together when CLI registration or dispatch behavior changes.",
      "files": ["src/runtime/commands/command-descriptors.ts", "src/runtime/command-kit/command-execution.ts"]
    }
  ],
  "coverageContracts": [
    {
      "name": "INSTALLABLE_SKILLS covers skills dirs",
      "file": "src/runtime/setup.ts",
      "keys": {
        "type": "string-array",
        "identifier": "INSTALLABLE_SKILLS"
      },
      "mustEqual": {
        "type": "top-level-dirs",
        "path": "skills"
