{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PlunderStruck/scip-query/blob/main/docs/schemas/npm-release-state.schema.json",
  "title": "scip-query npm release state",
  "description": "Durable local progress for one exact main-package and Windows-sidecar npm release.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "releaseId",
    "source",
    "packages",
    "completedStages",
    "createdAt",
    "updatedAt",
    "writer"
  ],
  "properties": {
    "kind": {
      "const": "scip-query-npm-release-state"
    },
    "schemaVersion": {
      "const": 1
    },
    "releaseId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "required": ["gitRevision", "registry"],
      "properties": {
        "gitRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "registry": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "allOf": [
            {
              "not": {
                "pattern": "^https://[^/]*@"
              }
            },
            {
              "not": {
                "pattern": "[?#]"
              }
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "packages": {
      "type": "object",
      "required": ["main", "sidecar"],
      "properties": {
        "main": {
          "$ref": "#/$defs/packageIdentity"
        },
        "sidecar": {
          "$ref": "#/$defs/packageIdentity"
        }
      },
      "additionalProperties": true
    },
    "completedStages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["local-preflight-complete", "sidecar-registry-verified", "main-registry-verified"]
      },
      "oneOf": [
        {
          "const": ["local-preflight-complete"]
        },
        {
          "const": ["local-preflight-complete", "sidecar-registry-verified"]
        },
        {
          "const": ["local-preflight-complete", "main-registry-verified"]
        },
        {
          "const": ["local-preflight-complete", "sidecar-registry-verified", "main-registry-verified"]
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "writer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "scip-query"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "The main-package version that produced this state; the executable reader requires it to equal packages.main.version."
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "packageIdentity": {
      "type": "object",
      "required": ["name", "version", "size", "shasum", "integrity"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "shasum": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "integrity": {
          "type": "string",
          "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
