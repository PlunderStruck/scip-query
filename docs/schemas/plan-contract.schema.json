{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/scip-query/docs/schemas/plan-contract.schema.json",
  "title": "scip-query Markdown plan contract v1",
  "description": "The machine-readable contract inside one scip-query-plan Markdown fence.",
  "type": "object",
  "required": [
    "schemaVersion",
    "workflowClass",
    "affectedSeeds",
    "preserve",
    "retirements",
    "allowedSurvivors",
    "reuseAuthorities",
    "architecture",
    "completionEvidence",
    "slices"
  ],
  "oneOf": [
    {
      "required": ["goalId", "changeId"],
      "not": { "anyOf": [{ "required": ["goal"] }, { "required": ["change"] }] }
    },
    {
      "required": ["goal", "change"],
      "not": { "anyOf": [{ "required": ["goalId"] }, { "required": ["changeId"] }] }
    }
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "goalId": { "$ref": "#/$defs/goalId" },
    "changeId": { "$ref": "#/$defs/changeId" },
    "goal": { "$ref": "./goal-create-request.schema.json" },
    "change": { "$ref": "#/$defs/initialChange" },
    "workflowClass": { "enum": ["relational", "sustained"] },
    "predecessorPlanId": { "$ref": "#/$defs/planId" },
    "affectedSeeds": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/affectedSeed" }
    },
    "preserve": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/condition" }
    },
    "retirements": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/retirement" }
    },
    "allowedSurvivors": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/survivor" }
    },
    "reuseAuthorities": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/reuseAuthority" }
    },
    "architecture": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/architectureCondition" }
    },
    "completionEvidence": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "slices": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/slice" }
    }
  },
  "$defs": {
    "goalId": { "type": "string", "pattern": "^SQG-[A-F0-9]{32}$" },
    "changeId": { "type": "string", "pattern": "^SQC-[A-F0-9]{32}$" },
    "planId": { "type": "string", "pattern": "^SQP-[A-F0-9]{32}$" },
    "itemId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "referentKind": {
      "enum": ["symbol", "file", "identity", "responsibility", "configuration", "test", "documentation", "architecture"]
    },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/itemId" }
    },
    "initialChange": {
      "type": "object",
      "required": ["idempotencyKey", "title", "intendedOutcome"],
      "properties": {
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 256 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "intendedOutcome": { "type": "string", "minLength": 1, "maxLength": 1000 }
      },
      "additionalProperties": false
    },
    "affectedSeed": {
      "type": "object",
      "required": ["id", "kind", "referent", "role"],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "kind": { "$ref": "#/$defs/referentKind" },
        "referent": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "role": { "type": "string", "minLength": 1, "maxLength": 1000 }
      },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "required": ["id", "condition", "evidenceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "condition": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
      },
      "additionalProperties": false
    },
    "architectureCondition": {
      "type": "object",
      "required": ["id", "predicate", "condition", "evidenceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "predicate": { "const": "configured-policy-clean" },
        "condition": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
      },
      "additionalProperties": false
    },
    "retirement": {
      "type": "object",
      "required": ["id", "kind", "referent", "responsibility", "condition", "evidenceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "kind": { "$ref": "#/$defs/referentKind" },
        "referent": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "responsibility": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "condition": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
      },
      "additionalProperties": false
    },
    "survivor": {
      "type": "object",
      "required": ["id", "referent", "authority", "authorityReferent", "currentRole", "evidenceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "referent": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "authority": { "enum": ["goal", "repository-policy", "delegated-decision"] },
        "authorityReferent": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "currentRole": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" },
        "removalCondition": { "type": "string", "minLength": 1, "maxLength": 1000 }
      },
      "additionalProperties": false
    },
    "reuseAuthority": {
      "type": "object",
      "required": ["id", "referent", "responsibility", "consumerSeedIds", "condition", "evidenceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "referent": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "responsibility": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "consumerSeedIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/itemId" }
        },
        "condition": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["id", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "command": { "type": "string", "minLength": 1, "maxLength": 1000 }
      },
      "additionalProperties": false
    },
    "slice": {
      "type": "object",
      "required": ["id", "outcome", "evidenceIds", "dependsOn"],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "outcome": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" },
        "dependsOn": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/itemId" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
