{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/scip-query/docs/schemas/completion-transition-rule-request.schema.json",
  "title": "scip-query completion transition-rule request",
  "description": "Transport input for pre-authorizing one exact autonomous successor transition.",
  "type": "object",
  "required": [
    "predecessorGoalId",
    "successorGoal",
    "successorChange",
    "permittedGoalFields",
    "preservedInvariants",
    "artifactTransitions",
    "requiredEvidence"
  ],
  "properties": {
    "predecessorGoalId": { "$ref": "./goal-create-request.schema.json#/$defs/goalId" },
    "successorGoal": {
      "type": "object",
      "required": ["feature", "invariants", "acceptanceScenarios", "authorization"],
      "properties": {
        "feature": { "type": "string", "minLength": 1, "maxLength": 500 },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "acceptanceScenarios": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "./goal-create-request.schema.json#/$defs/scenario" }
        },
        "authorization": { "$ref": "./goal-create-request.schema.json#/$defs/authorization" }
      },
      "additionalProperties": false
    },
    "successorChange": { "$ref": "#/$defs/successorChangeRequest" },
    "permittedGoalFields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["feature", "invariants", "acceptance-scenarios"] }
    },
    "preservedInvariants": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "artifactTransitions": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/artifactTransition" }
    },
    "requiredEvidence": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/evidenceQualification" },
            { "properties": { "predicate": { "const": "goal-fulfilled" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/evidenceQualification" },
            { "properties": { "predicate": { "const": "invariants-preserved" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/evidenceQualification" },
            { "properties": { "predicate": { "const": "evidence-compatible" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/evidenceQualification" },
            { "properties": { "predicate": { "const": "coverage-complete" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/evidenceQualification" },
            { "properties": { "predicate": { "const": "obligations-reconciled" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/evidenceQualification" },
            { "properties": { "predicate": { "const": "policy-permitted" } } }
          ]
        }
      ],
      "items": false
    }
  },
  "$defs": {
    "successorChangeRequest": {
      "type": "object",
      "required": ["idempotencyKey", "title", "intendedOutcome"],
      "properties": {
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 256 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "intendedOutcome": { "type": "string", "minLength": 1, "maxLength": 1000 }
      },
      "additionalProperties": false
    },
    "artifactTransition": {
      "type": "object",
      "required": ["class", "path", "predecessorDigest", "successorDigest"],
      "properties": {
        "class": { "enum": ["evaluator", "test", "baseline", "suppression", "configuration"] },
        "path": { "type": "string", "minLength": 1, "maxLength": 500 },
        "predecessorDigest": {
          "oneOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }]
        },
        "successorDigest": {
          "oneOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "evidenceQualification": {
      "type": "object",
      "required": ["predicate", "minimumReceipts", "requiredSources"],
      "properties": {
        "predicate": {
          "enum": [
            "goal-fulfilled",
            "invariants-preserved",
            "evidence-compatible",
            "coverage-complete",
            "obligations-reconciled",
            "policy-permitted"
          ]
        },
        "minimumReceipts": { "type": "integer", "minimum": 1, "maximum": 8 },
        "requiredSources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": ["index-generation", "repository-snapshot", "live-workspace", "process"]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
