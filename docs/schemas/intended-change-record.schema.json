{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/scip-query/docs/schemas/intended-change-record.schema.json",
  "title": "scip-query intended-change record v1",
  "description": "One immutable body of repository work stored under .scipquery/changes/.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "changeId",
    "collaborationDomainId",
    "goalId",
    "title",
    "intendedOutcome",
    "idempotency",
    "createdAt",
    "writer"
  ],
  "properties": {
    "kind": { "const": "scip-query-intended-change" },
    "schemaVersion": { "const": 1 },
    "changeId": { "type": "string", "pattern": "^SQC-[A-F0-9]{32}$" },
    "collaborationDomainId": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{8}-[a-fA-F0-9]{4}-4[a-fA-F0-9]{3}-[89abAB][a-fA-F0-9]{3}-[a-fA-F0-9]{12}$"
    },
    "goalId": { "$ref": "./goal-create-request.schema.json#/$defs/goalId" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "intendedOutcome": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "idempotency": {
      "type": "object",
      "required": ["version", "algorithm", "keyDigest", "requestDigest"],
      "properties": {
        "version": { "const": 1 },
        "algorithm": { "const": "sha256" },
        "keyDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "requestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "writer": { "$ref": "./goal-record.schema.json#/$defs/writer" }
  },
  "additionalProperties": false
}
