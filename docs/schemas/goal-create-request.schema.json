{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/scip-query/docs/schemas/goal-create-request.schema.json",
  "title": "scip-query goal create request",
  "description": "Transport input for creating one immutable repository goal.",
  "type": "object",
  "required": ["feature", "invariants", "acceptanceScenarios", "authorization"],
  "properties": {
    "feature": { "type": "string", "minLength": 1, "maxLength": 500 },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "acceptanceScenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/scenario" }
    },
    "authorization": { "$ref": "#/$defs/authorization" },
    "predecessorGoalId": { "$ref": "#/$defs/goalId" }
  },
  "$defs": {
    "goalId": { "type": "string", "pattern": "^SQG-[A-F0-9]{32}$" },
    "boundedStepList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "scenario": {
      "type": "object",
      "required": ["name", "given", "when", "then"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "given": { "$ref": "#/$defs/boundedStepList" },
        "when": { "$ref": "#/$defs/boundedStepList" },
        "then": { "$ref": "#/$defs/boundedStepList" }
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "required": ["kind", "principal", "source"],
      "properties": {
        "kind": { "const": "repository-delegation" },
        "principal": { "type": "string", "minLength": 1, "maxLength": 256 },
        "source": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
