{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/scip-query/docs/schemas/completion-transition-rule-record.schema.json",
  "title": "scip-query completion transition-rule record v1",
  "description": "One immutable pre-authorized successor bundle stored under .scipquery/transition-rules/.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "transitionRuleId",
    "collaborationDomainId",
    "predecessorGoal",
    "successorGoal",
    "successorChangeRequest",
    "successorChange",
    "permittedGoalFields",
    "preservedInvariants",
    "artifactTransitions",
    "requiredEvidence",
    "createdAt",
    "writer"
  ],
  "properties": {
    "kind": { "const": "scip-query-completion-transition-rule" },
    "schemaVersion": { "const": 1 },
    "transitionRuleId": { "type": "string", "pattern": "^SQTR-[A-F0-9]{32}$" },
    "collaborationDomainId": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{8}-[a-fA-F0-9]{4}-4[a-fA-F0-9]{3}-[89abAB][a-fA-F0-9]{3}-[a-fA-F0-9]{12}$"
    },
    "predecessorGoal": { "$ref": "./goal-record.schema.json" },
    "successorGoal": { "$ref": "./goal-record.schema.json" },
    "successorChangeRequest": {
      "$ref": "./completion-transition-rule-request.schema.json#/$defs/successorChangeRequest"
    },
    "successorChange": { "$ref": "./intended-change-record.schema.json" },
    "permittedGoalFields": {
      "$ref": "./completion-transition-rule-request.schema.json#/properties/permittedGoalFields"
    },
    "preservedInvariants": {
      "$ref": "./completion-transition-rule-request.schema.json#/properties/preservedInvariants"
    },
    "artifactTransitions": {
      "$ref": "./completion-transition-rule-request.schema.json#/properties/artifactTransitions"
    },
    "requiredEvidence": {
      "$ref": "./completion-transition-rule-request.schema.json#/properties/requiredEvidence"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "writer": { "$ref": "./goal-record.schema.json#/$defs/writer" }
  },
  "additionalProperties": false
}
