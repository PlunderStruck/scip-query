{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/scip-query/docs/schemas/completeness-admission-record.schema.json",
  "title": "scip-query completeness admission record v1",
  "description": "One immutable qualified, advisory, insufficient-evidence, or out-of-scope observation stored under .scipquery/completeness-admissions/.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "admissionRecordId",
    "collaborationDomainId",
    "changeId",
    "policy",
    "candidate",
    "relevance",
    "qualification",
    "evidenceReceipts",
    "disposition",
    "reasons",
    "createdAt",
    "writer"
  ],
  "properties": {
    "kind": { "const": "scip-query-completeness-admission" },
    "schemaVersion": { "const": 1 },
    "admissionRecordId": {
      "type": "string",
      "pattern": "^SQCA-[A-F0-9]{32}$"
    },
    "collaborationDomainId": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{8}-[a-fA-F0-9]{4}-4[a-fA-F0-9]{3}-[89abAB][a-fA-F0-9]{3}-[a-fA-F0-9]{12}$"
    },
    "changeId": {
      "$ref": "./obligation-admission-request.schema.json#/$defs/changeId"
    },
    "policy": { "$ref": "#/$defs/policy" },
    "candidate": { "$ref": "#/$defs/candidate" },
    "relevance": { "$ref": "#/$defs/relevance" },
    "qualification": { "$ref": "#/$defs/qualification" },
    "evidenceReceipts": {
      "allOf": [{ "$ref": "./attempt-record.schema.json#/$defs/evidenceReceipts" }, { "minItems": 1, "maxItems": 1 }]
    },
    "disposition": {
      "enum": ["admit", "advisory", "insufficient-evidence", "out-of-scope"]
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
    },
    "obligationId": {
      "$ref": "./obligation-admission-request.schema.json#/$defs/obligationId"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "writer": { "$ref": "./goal-record.schema.json#/$defs/writer" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "disposition": { "const": "admit" } },
        "required": ["disposition"]
      },
      "then": { "required": ["obligationId"] },
      "else": { "not": { "required": ["obligationId"] } }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "boundedLine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^[^\\r\\n]+$"
    },
    "canonicalLines": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/boundedLine" }
    },
    "policy": {
      "type": "object",
      "required": ["policyId", "policyVersion", "rules"],
      "properties": {
        "policyId": { "$ref": "#/$defs/boundedLine" },
        "policyVersion": { "const": 1 },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": [
        "ruleId",
        "checks",
        "category",
        "admissibleActionTiers",
        "minimumConfidence",
        "allowProducerAdvisory",
        "qualification"
      ],
      "properties": {
        "ruleId": { "$ref": "#/$defs/boundedLine" },
        "checks": { "$ref": "#/$defs/canonicalLines" },
        "category": {
          "enum": ["test", "documentation", "residue", "architecture", "migration", "verification", "other"]
        },
        "admissibleActionTiers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["direct", "signal", "support"] }
        },
        "minimumConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "allowProducerAdvisory": { "type": "boolean" },
        "qualification": {
          "type": "object",
          "properties": {
            "origins": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "compiler-graph",
                  "semantic-analysis",
                  "repository-source",
                  "change-history",
                  "runtime-measurement",
                  "heuristic",
                  "mixed",
                  "unknown"
                ]
              }
            },
            "coverage": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["complete", "partial", "unknown"] }
            },
            "producerValidation": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["validated", "failed", "not-evaluated", "not-applicable"] }
            },
            "stateAuthority": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["completion", "advisory", "none"] }
            },
            "actionPermission": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["observe", "advise", "require-adjudication", "block", "not-established"] }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "findingId",
        "check",
        "evidence",
        "actionTier",
        "confidence",
        "advisory",
        "relatedFiles",
        "message",
        "remediation"
      ],
      "properties": {
        "findingId": { "$ref": "#/$defs/boundedLine" },
        "check": { "$ref": "#/$defs/boundedLine" },
        "evidence": {
          "enum": ["graph-fact", "semantic", "heuristic", "change-graph", "baseline"]
        },
        "actionTier": { "enum": ["direct", "signal", "support"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "advisory": { "type": "boolean" },
        "file": { "$ref": "#/$defs/boundedLine" },
        "relatedFiles": { "$ref": "#/$defs/canonicalLines" },
        "message": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "remediation": { "type": "string", "minLength": 1, "maxLength": 4000 }
      },
      "additionalProperties": false
    },
    "relevance": {
      "type": "object",
      "required": ["state", "basis", "paths", "reasons"],
      "properties": {
        "state": { "enum": ["in-scope", "out-of-scope", "unknown"] },
        "basis": { "enum": ["candidate-diff", "affected-surface", "unrelated", "not-established"] },
        "paths": { "$ref": "#/$defs/canonicalLines" },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      },
      "additionalProperties": false
    },
    "qualification": {
      "type": "object",
      "required": ["schemaVersion", "origin", "coverage", "producerValidation", "stateAuthority", "repositoryPolicy"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "origin": {
          "enum": [
            "compiler-graph",
            "semantic-analysis",
            "repository-source",
            "change-history",
            "runtime-measurement",
            "heuristic",
            "mixed",
            "unknown"
          ]
        },
        "coverage": { "type": "object" },
        "producerValidation": { "type": "object" },
        "stateAuthority": { "type": "object" },
        "repositoryPolicy": { "type": "object" },
        "families": { "type": "array" }
      },
      "additionalProperties": false
    }
  }
}
