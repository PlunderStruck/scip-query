{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/scip-query/docs/schemas/protected-work-authorization-request.schema.json",
  "title": "scip-query protected work authorization request",
  "description": "Principal-controlled input fixing one prompt, goal, intended change, and exact protected artifact transitions before candidate work begins.",
  "type": "object",
  "required": ["principal", "promptSha256", "goal", "change", "artifactTransitions"],
  "properties": {
    "principal": { "type": "string", "minLength": 1, "maxLength": 256 },
    "promptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goal": {
      "type": "object",
      "required": ["feature", "invariants", "acceptanceScenarios"],
      "properties": {
        "feature": { "type": "string", "minLength": 1, "maxLength": 500 },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "acceptanceScenarios": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "./goal-create-request.schema.json#/$defs/scenario" }
        }
      },
      "additionalProperties": false
    },
    "change": { "$ref": "#/$defs/changeRequest" },
    "artifactTransitions": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "./completion-transition-rule-request.schema.json#/$defs/artifactTransition" }
    }
  },
  "$defs": {
    "changeRequest": {
      "type": "object",
      "required": ["idempotencyKey", "title", "intendedOutcome"],
      "properties": {
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 256 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "intendedOutcome": { "type": "string", "minLength": 1, "maxLength": 1000 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
