{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/scip-query/docs/schemas/decision-record.schema.json",
  "title": "scip-query decision record v1",
  "description": "One immutable evidence-based next-action decision stored under .scipquery/decisions/.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "decisionId",
    "collaborationDomainId",
    "changeId",
    "basisAttemptIds",
    "evidenceReceipts",
    "disposition",
    "rationale",
    "idempotency",
    "createdAt",
    "writer"
  ],
  "properties": {
    "kind": { "const": "scip-query-decision" },
    "schemaVersion": { "const": 1 },
    "decisionId": { "type": "string", "pattern": "^SQD-[A-F0-9]{32}$" },
    "collaborationDomainId": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{8}-[a-fA-F0-9]{4}-4[a-fA-F0-9]{3}-[89abAB][a-fA-F0-9]{3}-[a-fA-F0-9]{12}$"
    },
    "changeId": { "$ref": "./attempt-create-request.schema.json#/$defs/changeId" },
    "basisAttemptIds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "./attempt-create-request.schema.json#/$defs/attemptId" }
    },
    "evidenceReceipts": {
      "$ref": "./attempt-create-request.schema.json#/$defs/evidenceReceipts"
    },
    "disposition": {
      "$ref": "./decision-create-request.schema.json#/properties/disposition"
    },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "nextAction": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "idempotency": { "$ref": "./attempt-record.schema.json#/$defs/idempotency" },
    "createdAt": { "type": "string", "format": "date-time" },
    "writer": { "$ref": "./goal-record.schema.json#/$defs/writer" }
  },
  "additionalProperties": false
}
