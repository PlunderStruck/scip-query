{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/scip-query/docs/schemas/completion-context-record.schema.json",
  "title": "scip-query completion context record v1",
  "description": "One immutable goal, intended change, policy, evaluator, check-registry, protected-artifact, optional external authorization, and target bundle stored under .scipquery/completion-contexts/.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "contextSnapshotId",
    "collaborationDomainId",
    "changeId",
    "goalId",
    "goalRecordDigest",
    "policy",
    "evaluator",
    "commandRegistry",
    "protectedArtifacts",
    "targetObservation",
    "capturedAt",
    "createdAt",
    "writer"
  ],
  "properties": {
    "kind": { "const": "scip-query-completion-context" },
    "schemaVersion": { "const": 1 },
    "contextSnapshotId": { "type": "string", "pattern": "^SQCX-[A-F0-9]{32}$" },
    "collaborationDomainId": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{8}-[a-fA-F0-9]{4}-4[a-fA-F0-9]{3}-[89abAB][a-fA-F0-9]{3}-[a-fA-F0-9]{12}$"
    },
    "changeId": { "$ref": "./attempt-create-request.schema.json#/$defs/changeId" },
    "goalId": { "$ref": "./intended-change-create-request.schema.json#/$defs/goalId" },
    "goalRecordDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "changeRecordDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policy": {
      "type": "object",
      "required": ["policyId", "policyVersion", "stopMode", "requiredPredicates"],
      "properties": {
        "policyId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "policyVersion": { "type": "integer", "minimum": 1 },
        "stopMode": { "enum": ["warn", "feedback", "block"] },
        "requiredPredicates": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
            { "const": "goal-fulfilled" },
            { "const": "invariants-preserved" },
            { "const": "evidence-compatible" },
            { "const": "coverage-complete" },
            { "const": "obligations-reconciled" },
            { "const": "policy-permitted" }
          ],
          "items": false
        }
      },
      "additionalProperties": false
    },
    "evaluator": {
      "type": "object",
      "required": ["evaluatorId", "evaluatorVersion", "buildIdentity"],
      "properties": {
        "evaluatorId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "evaluatorVersion": { "type": "string", "minLength": 1, "maxLength": 200 },
        "buildIdentity": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "commandRegistry": {
      "type": "object",
      "required": ["registryIdentity", "entries"],
      "properties": {
        "registryIdentity": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      },
      "additionalProperties": false
    },
    "protectedArtifacts": {
      "type": "object",
      "required": ["setIdentity", "rules"],
      "properties": {
        "setIdentity": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "rules": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/protectedArtifactRule" }
        }
      },
      "additionalProperties": false
    },
    "targetObservation": {
      "$ref": "./observation-receipt.schema.json#/$defs/observationReceiptV2"
    },
    "protectedWorkAuthorization": {
      "type": "object",
      "required": ["authorizationId", "recordSha256", "goalRecordDigest", "changeRecordDigest"],
      "properties": {
        "authorizationId": { "type": "string", "pattern": "^SQWA-[A-F0-9]{32}$" },
        "recordSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "goalRecordDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "changeRecordDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "protectedGoalEvidence": {
      "type": "object",
      "required": ["evidenceId", "recordSha256", "authorizationId", "evaluatorArtifactSha256"],
      "properties": {
        "evidenceId": { "type": "string", "pattern": "^SQGE-[A-F0-9]{32}$" },
        "recordSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "authorizationId": { "type": "string", "pattern": "^SQWA-[A-F0-9]{32}$" },
        "evaluatorArtifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "capturedAt": { "type": "string", "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" },
    "writer": { "$ref": "./goal-record.schema.json#/$defs/writer" }
  },
  "additionalProperties": false,
  "$defs": {
    "protectedArtifactRule": {
      "type": "object",
      "required": ["class", "selectors", "authority"],
      "properties": {
        "class": {
          "enum": ["goal", "transition-rule", "evaluator", "test", "baseline", "suppression", "configuration"]
        },
        "selectors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "authority": { "enum": ["bootstrap-trust-root", "fixed-predecessor"] }
      },
      "additionalProperties": false
    }
  }
}
