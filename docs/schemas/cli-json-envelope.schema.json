{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ainsleyclark/scip-query/blob/main/docs/schemas/cli-json-envelope.schema.json",
  "title": "scip-query CLI JSON envelope v1",
  "description": "The public transport record emitted by scip-query commands that accept --json.",
  "type": "object",
  "required": ["kind", "schemaVersion", "producer", "command", "resultSchemaVersion", "args", "options", "result"],
  "properties": {
    "kind": {
      "const": "scip-query-result"
    },
    "schemaVersion": {
      "const": 1
    },
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "scip-query"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "operationRole": {
      "enum": [
        "repository-observation",
        "repository-preview",
        "mutation",
        "composite",
        "environment-observation",
        "tool-information"
      ]
    },
    "resultSchemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "evidence": {
      "enum": ["graph-fact", "heuristic", "mixed"]
    },
    "analysisBudget": {},
    "args": {
      "type": "array"
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    },
    "result": {},
    "coverage": {},
    "agentResult": {},
    "evidenceContext": {
      "$ref": "#/$defs/evidenceContextV1"
    }
  },
  "$defs": {
    "evidenceContextV1": {
      "type": "object",
      "required": ["schemaVersion", "receipt", "analysisManifest"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "operationRole": {
          "enum": [
            "repository-observation",
            "repository-preview",
            "mutation",
            "composite",
            "environment-observation",
            "tool-information"
          ]
        },
        "receipt": {
          "$ref": "#/$defs/observationReceiptV1"
        },
        "analysisManifest": {
          "$ref": "#/$defs/analysisManifestV1"
        }
      },
      "additionalProperties": true
    },
    "analysisManifestV1": {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "evidence": {
          "enum": ["graph-fact", "heuristic", "mixed"]
        },
        "analysisBudget": {},
        "coverage": {}
      },
      "additionalProperties": true
    },
    "observationReceiptV1": {
      "type": "object",
      "required": ["schemaVersion", "authorityKind", "observedAt", "projectIdentity"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "authorityKind": {
          "enum": ["index-worktree", "index-only", "worktree-only", "process-local"]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "projectIdentity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "index": {
          "type": "object",
          "required": ["generationIdentity", "source", "alignment"],
          "properties": {
            "generationIdentity": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "source": {
              "enum": ["immutable", "legacy"]
            },
            "alignment": {
              "enum": ["not-certified", "leased"]
            }
          },
          "additionalProperties": true
        },
        "worktree": {
          "type": "object",
          "required": ["identity", "clean"],
          "properties": {
            "identity": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "clean": {
              "type": "boolean"
            },
            "headCommit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "treeOid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
