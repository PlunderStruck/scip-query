{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scip-query.dev/schemas/mission-trial-program.schema.json",
  "title": "scip-query mission trial program",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "programId",
    "semanticDigest",
    "title",
    "fixedPredecessorCommit",
    "fixtures",
    "agent",
    "budgets",
    "maximumRerunsPerCondition",
    "decisionThresholds",
    "conditions",
    "createdAt",
    "writer"
  ],
  "properties": {
    "kind": { "const": "scip-query-mission-trial-program" },
    "schemaVersion": { "const": 1 },
    "programId": { "type": "string", "pattern": "^SQTP-[A-F0-9]{32}$" },
    "semanticDigest": { "$ref": "#/$defs/sha256" },
    "title": { "$ref": "#/$defs/boundedLine" },
    "fixedPredecessorCommit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/fixture" }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "runtime", "parametersSha256"],
      "properties": {
        "provider": { "$ref": "#/$defs/boundedLine" },
        "model": { "$ref": "#/$defs/boundedLine" },
        "runtime": { "$ref": "#/$defs/boundedLine" },
        "parametersSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxElapsedMs", "maxModelTokens", "maxToolCalls", "maxAttempts"],
      "properties": {
        "maxElapsedMs": { "type": "integer", "minimum": 1 },
        "maxModelTokens": { "type": "integer", "minimum": 1 },
        "maxToolCalls": { "type": "integer", "minimum": 1 },
        "maxAttempts": { "type": "integer", "minimum": 1 }
      }
    },
    "maximumRerunsPerCondition": { "type": "integer", "minimum": 1, "maximum": 20 },
    "decisionThresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "minimumPairs",
        "minimumFullCompletionRateDelta",
        "maximumTreatmentFalseBlockingRate",
        "maximumArchitectureRegressionRate",
        "maximumElapsedRegressionRatio",
        "maximumTokenRegressionRatio",
        "confidenceLevel",
        "requireEfficiencyImprovement"
      ],
      "properties": {
        "version": { "const": 1 },
        "minimumPairs": { "type": "integer", "minimum": 1 },
        "minimumFullCompletionRateDelta": { "$ref": "#/$defs/rate" },
        "maximumTreatmentFalseBlockingRate": { "$ref": "#/$defs/rate" },
        "maximumArchitectureRegressionRate": { "$ref": "#/$defs/rate" },
        "maximumElapsedRegressionRatio": { "type": "number", "minimum": 1 },
        "maximumTokenRegressionRatio": { "type": "number", "minimum": 1 },
        "confidenceLevel": { "$ref": "#/$defs/rate" },
        "requireEfficiencyImprovement": { "const": "elapsed-or-tokens" }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control", "treatment"],
      "properties": {
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflow"],
          "properties": { "workflow": { "const": "disabled" } }
        },
        "treatment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflow"],
          "properties": { "workflow": { "const": "autonomous-completion-v1" } }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "writer": { "$ref": "#/$defs/writer" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "boundedLine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "sha256"],
      "properties": {
        "relativePath": { "$ref": "#/$defs/boundedLine" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixtureId",
        "description",
        "authorizedGoal",
        "repositoryArchive",
        "protectedEvaluator",
        "affectedSurface"
      ],
      "properties": {
        "fixtureId": { "$ref": "#/$defs/boundedLine" },
        "description": { "$ref": "#/$defs/boundedLine" },
        "authorizedGoal": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "repositoryArchive": { "$ref": "#/$defs/artifact" },
        "protectedEvaluator": { "$ref": "#/$defs/artifact" },
        "affectedSurface": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/boundedLine" }
        }
      }
    },
    "writer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version"],
      "properties": {
        "tool": { "const": "scip-query" },
        "version": { "$ref": "#/$defs/boundedLine" }
      }
    }
  }
}
