{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/scip-query/docs/schemas/obligation-admission-record.schema.json",
  "title": "scip-query obligation admission record v1",
  "description": "One immutable completion condition stored under .scipquery/obligations/.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "obligationId",
    "collaborationDomainId",
    "changeId",
    "category",
    "title",
    "requiredCondition",
    "source",
    "basisAttemptIds",
    "evidenceReceipts",
    "idempotency",
    "createdAt",
    "writer"
  ],
  "properties": {
    "kind": { "const": "scip-query-obligation-admission" },
    "schemaVersion": { "const": 1 },
    "obligationId": {
      "$ref": "./obligation-admission-request.schema.json#/$defs/obligationId"
    },
    "collaborationDomainId": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{8}-[a-fA-F0-9]{4}-4[a-fA-F0-9]{3}-[89abAB][a-fA-F0-9]{3}-[a-fA-F0-9]{12}$"
    },
    "changeId": {
      "$ref": "./obligation-admission-request.schema.json#/$defs/changeId"
    },
    "category": {
      "$ref": "./obligation-admission-request.schema.json#/$defs/category"
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "requiredCondition": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "source": {
      "$ref": "./obligation-admission-request.schema.json#/$defs/source"
    },
    "basisAttemptIds": {
      "$ref": "./obligation-admission-request.schema.json#/$defs/basisAttemptIds"
    },
    "evidenceReceipts": {
      "$ref": "./obligation-admission-request.schema.json#/$defs/evidenceReceipts"
    },
    "idempotency": { "$ref": "./attempt-record.schema.json#/$defs/idempotency" },
    "createdAt": { "type": "string", "format": "date-time" },
    "writer": { "$ref": "./goal-record.schema.json#/$defs/writer" }
  },
  "additionalProperties": false
}
