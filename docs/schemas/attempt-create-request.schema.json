{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/scip-query/docs/schemas/attempt-create-request.schema.json",
  "title": "scip-query attempt create request",
  "description": "Bounded request for one immutable purposeful action and its observed effect.",
  "type": "object",
  "required": [
    "changeId",
    "idempotencyKey",
    "intendedCondition",
    "action",
    "evidenceReceipts",
    "observedEffect",
    "outcome"
  ],
  "properties": {
    "changeId": { "$ref": "#/$defs/changeId" },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 256 },
    "intendedCondition": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "action": { "$ref": "#/$defs/action" },
    "evidenceReceipts": { "$ref": "#/$defs/evidenceReceipts" },
    "observedEffect": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "outcome": { "$ref": "#/$defs/outcome" },
    "reconcilesAttemptId": { "$ref": "#/$defs/attemptId" }
  },
  "additionalProperties": false,
  "$defs": {
    "changeId": { "type": "string", "pattern": "^SQC-[A-F0-9]{32}$" },
    "attemptId": { "type": "string", "pattern": "^SQA-[A-F0-9]{32}$" },
    "outcome": { "enum": ["succeeded", "failed", "unknown"] },
    "action": {
      "type": "object",
      "required": ["family", "summary", "effectClass"],
      "properties": {
        "family": { "type": "string", "minLength": 1, "maxLength": 120 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "effectClass": {
          "enum": ["read-only", "idempotent-write", "non-idempotent-write"]
        }
      },
      "additionalProperties": false
    },
    "evidenceReceipts": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "./observation-receipt.schema.json#/$defs/observationReceiptV2"
      }
    }
  }
}
