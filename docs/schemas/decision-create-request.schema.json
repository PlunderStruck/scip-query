{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/scip-query/docs/schemas/decision-create-request.schema.json",
  "title": "scip-query decision create request",
  "description": "Bounded request for one immutable evidence-based next-action decision.",
  "type": "object",
  "required": [
    "changeId",
    "idempotencyKey",
    "basisAttemptIds",
    "evidenceReceipts",
    "disposition",
    "rationale"
  ],
  "properties": {
    "changeId": { "$ref": "./attempt-create-request.schema.json#/$defs/changeId" },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 256 },
    "basisAttemptIds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "./attempt-create-request.schema.json#/$defs/attemptId" }
    },
    "evidenceReceipts": {
      "$ref": "./attempt-create-request.schema.json#/$defs/evidenceReceipts"
    },
    "disposition": {
      "enum": [
        "continue",
        "retry-safe",
        "change-strategy",
        "reconcile-unknown",
        "completion-candidate",
        "abandon"
      ]
    },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "nextAction": { "type": "string", "minLength": 1, "maxLength": 1000 }
  },
  "additionalProperties": false
}
