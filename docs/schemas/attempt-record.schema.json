{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/scip-query/docs/schemas/attempt-record.schema.json",
  "title": "scip-query attempt record v1",
  "description": "One immutable purposeful action stored under .scipquery/attempts/.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "attemptId",
    "collaborationDomainId",
    "changeId",
    "intendedCondition",
    "action",
    "evidenceReceipts",
    "observedEffect",
    "outcome",
    "idempotency",
    "createdAt",
    "writer"
  ],
  "properties": {
    "kind": { "const": "scip-query-attempt" },
    "schemaVersion": { "const": 1 },
    "attemptId": { "$ref": "./attempt-create-request.schema.json#/$defs/attemptId" },
    "collaborationDomainId": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{8}-[a-fA-F0-9]{4}-4[a-fA-F0-9]{3}-[89abAB][a-fA-F0-9]{3}-[a-fA-F0-9]{12}$"
    },
    "changeId": { "$ref": "./attempt-create-request.schema.json#/$defs/changeId" },
    "intendedCondition": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "action": { "$ref": "./attempt-create-request.schema.json#/$defs/action" },
    "evidenceReceipts": {
      "$ref": "./attempt-create-request.schema.json#/$defs/evidenceReceipts"
    },
    "observedEffect": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "outcome": { "$ref": "./attempt-create-request.schema.json#/$defs/outcome" },
    "reconcilesAttemptId": {
      "$ref": "./attempt-create-request.schema.json#/$defs/attemptId"
    },
    "idempotency": { "$ref": "#/$defs/idempotency" },
    "createdAt": { "type": "string", "format": "date-time" },
    "writer": { "$ref": "./goal-record.schema.json#/$defs/writer" }
  },
  "additionalProperties": false,
  "$defs": {
    "idempotency": {
      "type": "object",
      "required": ["version", "algorithm", "keyDigest", "requestDigest"],
      "properties": {
        "version": { "const": 1 },
        "algorithm": { "const": "sha256" },
        "keyDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "requestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  }
}
