{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/scip-query/docs/schemas/completion-transition-record.schema.json",
  "title": "scip-query completion transition record v1",
  "description": "One immutable witness of a controller-produced complete evaluation stored under .scipquery/completion-transitions/.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "transitionId",
    "collaborationDomainId",
    "changeId",
    "goalId",
    "evaluationId",
    "contextId",
    "to",
    "createdAt",
    "writer"
  ],
  "properties": {
    "kind": { "const": "scip-query-completion-transition" },
    "schemaVersion": { "const": 1 },
    "transitionId": { "type": "string", "pattern": "^SQCT-[A-F0-9]{32}$" },
    "collaborationDomainId": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{8}-[a-fA-F0-9]{4}-4[a-fA-F0-9]{3}-[89abAB][a-fA-F0-9]{3}-[a-fA-F0-9]{12}$"
    },
    "changeId": { "$ref": "./attempt-create-request.schema.json#/$defs/changeId" },
    "goalId": { "$ref": "./intended-change-create-request.schema.json#/$defs/goalId" },
    "evaluationId": { "type": "string", "pattern": "^SQE-[A-F0-9]{32}$" },
    "contextId": { "type": "string", "pattern": "^SQX-[A-F0-9]{32}$" },
    "to": { "const": "complete" },
    "createdAt": { "type": "string", "format": "date-time" },
    "writer": { "$ref": "./goal-record.schema.json#/$defs/writer" }
  },
  "additionalProperties": false
}
