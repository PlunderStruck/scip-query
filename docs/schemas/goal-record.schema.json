{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/scip-query/docs/schemas/goal-record.schema.json",
  "title": "scip-query goal record v1",
  "description": "One immutable semantic goal version stored under .scipquery/goals/.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "goalId",
    "collaborationDomainId",
    "gherkin",
    "semanticIdentity",
    "authorization",
    "createdAt",
    "writer"
  ],
  "properties": {
    "kind": { "const": "scip-query-goal" },
    "schemaVersion": { "const": 1 },
    "goalId": { "$ref": "./goal-create-request.schema.json#/$defs/goalId" },
    "collaborationDomainId": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{8}-[a-fA-F0-9]{4}-4[a-fA-F0-9]{3}-[89abAB][a-fA-F0-9]{3}-[a-fA-F0-9]{12}$"
    },
    "gherkin": {
      "type": "object",
      "required": ["language", "feature", "invariants", "acceptanceScenarios"],
      "properties": {
        "language": { "const": "gherkin" },
        "feature": { "type": "string", "minLength": 1, "maxLength": 500 },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "acceptanceScenarios": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "./goal-create-request.schema.json#/$defs/scenario" }
        }
      },
      "additionalProperties": false
    },
    "semanticIdentity": {
      "type": "object",
      "required": ["algorithm", "canonicalizationVersion", "digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "canonicalizationVersion": { "const": 1 },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "predecessorGoalId": { "$ref": "./goal-create-request.schema.json#/$defs/goalId" },
    "authorization": { "$ref": "./goal-create-request.schema.json#/$defs/authorization" },
    "createdAt": { "type": "string", "format": "date-time" },
    "writer": { "$ref": "#/$defs/writer" }
  },
  "$defs": {
    "writer": {
      "type": "object",
      "required": ["tool", "version"],
      "properties": {
        "tool": { "const": "scip-query" },
        "version": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
