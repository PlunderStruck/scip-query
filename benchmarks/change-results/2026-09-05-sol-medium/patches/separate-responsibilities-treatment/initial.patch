--- /dev/null
+++ b/test/quote.test.mjs
@@ -0,0 +1,33 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import {
+  chargeFee,
+  checkoutQuote,
+  refundFee,
+  supportQuote,
+} from '../build/index.js';
+
+test('public quote operations use the shared cent-rounded calculation', () => {
+  const cases = [
+    { unitPrice: 10.25, quantity: 2, expected: 20.5 },
+    { unitPrice: 0.335, quantity: 1, expected: 0.34 },
+    { unitPrice: 3.333, quantity: 3, expected: 10 },
+  ];
+
+  for (const { unitPrice, quantity, expected } of cases) {
+    assert.equal(checkoutQuote(unitPrice, quantity), expected);
+    assert.equal(supportQuote(unitPrice, quantity), expected);
+  }
+});
+
+test('charge and refund fees retain their independent public behavior', () => {
+  for (const { amount, expected } of [
+    { amount: 10, expected: 1 },
+    { amount: 100, expected: 2 },
+    { amount: 125, expected: 3 },
+  ]) {
+    assert.equal(chargeFee(amount), expected);
+    assert.equal(refundFee(amount), expected);
+  }
+});
