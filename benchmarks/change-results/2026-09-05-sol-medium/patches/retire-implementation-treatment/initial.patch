@@ -0,0 +1,30 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { receiptJobs, receiptRoutes, sendReceipt, settings } from '../build/index.js';
+
+test('receipt entry points use the current transport with caller-owned stores', () => {
+  assert.equal(receiptRoutes.receipt, sendReceipt);
+  assert.equal(receiptJobs.receipt, sendReceipt);
+
+  const order = { id: 'order-17', email: 'buyer@example.com' };
+  const routeStore = { events: [] };
+  const jobStore = { events: [] };
+
+  receiptRoutes.receipt(order, routeStore);
+  receiptJobs.receipt(order, jobStore);
+
+  const event = {
+    kind: 'receipt.sent',
+    orderId: order.id,
+    to: order.email,
+    transport: 'v2',
+  };
+  assert.deepEqual(routeStore.events, [event]);
+  assert.deepEqual(jobStore.events, [event]);
+  assert.notEqual(routeStore.events, jobStore.events);
+});
+
+test('receipt settings retain only the current retry limit', () => {
+  assert.deepEqual(settings, { receiptRetryLimit: 3 });
+});
