diff --git a/test/batch-shipping.test.mjs b/test/batch-shipping.test.mjs
new file mode 100644
index 0000000..3098f58
--- /dev/null
+++ b/test/batch-shipping.test.mjs
@@ -0,0 +1,16 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { batchShippingQuote, webShippingQuote } from '../build/index.js';
+
+test('batchShippingQuote uses each caller-supplied rate independently', () => {
+  assert.equal(batchShippingQuote(2, 3), 6);
+  assert.equal(batchShippingQuote(2, 11), 22);
+  assert.equal(batchShippingQuote(2, 3), 6);
+});
+
+test('batch shipping rates do not change the configured web rate', () => {
+  batchShippingQuote(2, 11);
+
+  assert.equal(webShippingQuote(2), 14);
+});
