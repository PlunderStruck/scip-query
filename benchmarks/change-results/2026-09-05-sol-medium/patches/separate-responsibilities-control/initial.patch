@@ -0,0 +1,28 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { chargeFee, checkoutQuote, refundFee, supportQuote } from '../build/index.js';
+
+test('checkout and support quotes use the same cent-rounded price', () => {
+  const cases = [
+    { unitPrice: 10.25, quantity: 2, expected: 20.5 },
+    { unitPrice: 1.234, quantity: 1, expected: 1.23 },
+    { unitPrice: 1.235, quantity: 1, expected: 1.24 },
+  ];
+
+  for (const { unitPrice, quantity, expected } of cases) {
+    assert.equal(checkoutQuote(unitPrice, quantity), expected);
+    assert.equal(supportQuote(unitPrice, quantity), expected);
+  }
+});
+
+test('charge and refund fees retain their separate existing behavior', () => {
+  for (const [amount, expected] of [
+    [0, 1],
+    [100, 2],
+    [175, 4],
+  ]) {
+    assert.equal(chargeFee(amount), expected);
+    assert.equal(refundFee(amount), expected);
+  }
+});
