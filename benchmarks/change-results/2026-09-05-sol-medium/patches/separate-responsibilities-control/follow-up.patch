diff --git a/src/pricing/quote.ts b/src/pricing/quote.ts
index f0f49ec..f9833fc 100644
--- a/src/pricing/quote.ts
+++ b/src/pricing/quote.ts
@@ -1,3 +1,4 @@
-export function calculateQuote(unitPrice: number, quantity: number): number {
-  return Math.round(unitPrice * quantity * 100) / 100;
+export function calculateQuote(unitPrice: number, quantity: number, discountPercent = 0): number {
+  const discountedTotal = unitPrice * quantity * (1 - discountPercent / 100);
+  return Math.round(discountedTotal * 100) / 100;
 }
