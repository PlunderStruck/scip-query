--- /dev/null
+++ b/test/receipt.test.mjs
@@ -0,0 +1,29 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { receiptJobs, receiptRoutes, sendReceipt, settings } from '../build/index.js';
+
+for (const [operationName, receipt] of [
+  ['receiptRoutes.receipt', receiptRoutes.receipt],
+  ['receiptJobs.receipt', receiptJobs.receipt],
+]) {
+  test(`${operationName} uses sendReceipt with the caller's store`, () => {
+    const store = { events: [] };
+
+    assert.equal(receipt, sendReceipt);
+    receipt({ id: 'order-42', email: 'buyer@example.com' }, store);
+
+    assert.deepEqual(store.events, [
+      {
+        kind: 'receipt.sent',
+        orderId: 'order-42',
+        to: 'buyer@example.com',
+        transport: 'v2',
+      },
+    ]);
+  });
+}
+
+test('receipt settings retain only the supported retry limit', () => {
+  assert.deepEqual(settings, { receiptRetryLimit: 3 });
+});
