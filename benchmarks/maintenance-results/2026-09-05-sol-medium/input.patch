-  return {
-    query,
-    queryPathFragments,
-    normalizedTerms,
-    matchedTerms,
-    unmatchedTerms,
-    groups: selectedGroups,
-    candidateRoots,
-    candidateRootCount: candidateRoots.length,
-    analyzedRootCount,
-    omittedRootCount,
-    omittedGroupCount,
-    scannedFiles: inventory.files.length,
-    scannedBytes: inventory.scannedBytes,
-    recoveryCommand:
-      omittedGroupCount === 0
