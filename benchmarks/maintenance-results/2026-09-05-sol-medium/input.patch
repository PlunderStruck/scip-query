-function normalizedGapCallee(value: string): string {
-  const compact = value.replace(/\(\)$/u, '').replace(/^#/u, '');
-  return (
-    compact.slice(Math.max(compact.lastIndexOf(':'), compact.lastIndexOf('.')) + 1) || compact
-  ).toLocaleLowerCase();
-}
