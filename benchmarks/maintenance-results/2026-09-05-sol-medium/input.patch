-    documentId,
-    symbolId,
-    symbol: `${SOURCE_CONSTRUCT_SYMBOL_PREFIX}${relativePath}:${callable.startLine}:${callable.endLine}:${callable.name}`,
-    relativePath,
-    startLine: callable.startLine,
-    startChar: 0,
-    endLine: callable.endLine,
-    endChar: 0,
-    leaf: callable.name,
-    parentTypeName: null,
-    isFunctionLike: true,
-    isTypeLike: false,
