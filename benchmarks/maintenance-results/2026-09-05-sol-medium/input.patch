-function selectKeyAnchors(
-  roots: readonly AnchorDiscoveryCandidate[],
-  relations: readonly AnchorDiscoveryRelation[],
-  candidatesBySymbol: ReadonlyMap<string, AnchorDiscoveryCandidate>,
-): AnchorDiscoveryCandidate[] {
