@@ -0,0 +1,15 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { batchShippingQuote, webShippingQuote } from '../build/index.js';
+
+test('batch shipping quotes use each caller-supplied rate independently', () => {
+  assert.equal(batchShippingQuote(2, 3), 6);
+  assert.equal(batchShippingQuote(2, 11), 22);
+  assert.equal(batchShippingQuote(2, 3), 6);
+});
+
+test('batch shipping quotes do not change the web shipping rate', () => {
+  batchShippingQuote(2, 11);
+
+  assert.equal(webShippingQuote(2), 14);
+});
