  "scripts": {
    "build": "node --max-old-space-size=16384 ./node_modules/tsup/dist/cli-default.js",
    "dev": "tsup --watch",
    "format": "prettier --write \"{src,tests,scripts}/**/*.{ts,tsx,js,mjs,json}\" \"skills/**/scripts/*.{js,mjs}\" \"*.{ts,js,json}\"",
    "format:check": "prettier --check \"{src,tests,scripts}/**/*.{ts,tsx,js,mjs,json}\" \"skills/**/scripts/*.{js,mjs}\" \"*.{ts,js,json}\"",
    "test": "vitest run --maxWorkers=2",
    "soak:cache-lifecycle": "npm run build && vite-node scripts/cache-lifecycle-soak.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tests/fixtures/invocation-coverage-contract/tsconfig.json && tsc -p tests/fixtures/protocol-state-contract/tsconfig.json",
    "audit:prod": "node scripts/audit-production-dependencies.mjs",
    "api:report": "node scripts/api-surface-contract.mjs report",
    "api:check": "npm run build && node scripts/api-surface-contract.mjs check && tsc -p tests/fixtures/public-api-consumer/tsconfig.json",
    "api:update": "npm run build && node scripts/api-surface-contract.mjs update",
    "lint": "npm run format:check && eslint src tests tsup.config.ts scripts/api-surface-contract.mjs scripts/audit-production-dependencies.mjs scripts/benchmark-cold-reindex.ts scripts/benchmark-graph-literal.ts scripts/benchmark-query-service.ts scripts/benchmark-reindex-accounting.ts scripts/benchmark-source-search.ts scripts/build-scip-windows.mjs scripts/cache-lifecycle-soak.ts scripts/codex-exploration-sandbox.mjs scripts/codex-exploration-trial-core.mjs scripts/codex-exploration-trial.mjs scripts/compare-exploration-trials.mjs scripts/exploration-benchmark-core.mjs scripts/exploration-benchmark.mjs scripts/npm-release-state.ts scripts/npm-release.ts scripts/publish-scip-windows.ts scripts/release-npm-guard.ts scripts/release-npm.ts scripts/scip-windows-package-identity.ts scripts/scip-windows-provenance.mjs scripts/scip-windows-release.ts scripts/score-detector-labels.ts scripts/verify-identity-collision-cli.mjs scripts/verify-scip-windows.mjs scripts/verify-scip-windows-registry.ts skills/scip-explore/scripts/capture-evidence.mjs && npm run api:check && node scripts/check-skill-links.mjs",
    "build:scip-windows": "node scripts/build-scip-windows.mjs",
    "verify:scip-windows": "node scripts/verify-scip-windows.mjs",
    "verify:identity-collision-cli": "node scripts/verify-identity-collision-cli.mjs",
    "verify:scip-windows-registry": "vite-node scripts/verify-scip-windows-registry.ts",
    "bench:evidence-products": "node scripts/evidence-product-contract.mjs",
    "bench:exploration": "node scripts/exploration-benchmark.mjs",
    "bench:exploration:codex": "node scripts/codex-exploration-trial.mjs",
    "bench:exploration:compare": "node scripts/compare-exploration-trials.mjs",
    "bench:cold-reindex": "vite-node scripts/benchmark-cold-reindex.ts",
    "bench:edit-latency": "vite-node scripts/benchmark-edit-latency.ts",
    "bench:graph-literal": "vite-node scripts/benchmark-graph-literal.ts",
    "bench:query-service": "npm run build && vite-node scripts/benchmark-query-service.ts",
    "bench:reindex-accounting": "vite-node scripts/benchmark-reindex-accounting.ts",
    "bench:source-search": "vite-node scripts/benchmark-source-search.ts",
    "bench:native-symbol-leaf": "node scripts/bench-native-symbol-leaf.mjs",
    "bench:agent-output": "npm run build -- --silent && vite-node scripts/benchmark-agent-output.ts",
    "calibrate": "node scripts/accuracy-calibration.mjs",
    "docs:commands": "vite-node scripts/render-command-reference.ts --write",
    "prepublishOnly": "vite-node scripts/release-npm-guard.ts",
    "postinstall": "node dist/postinstall.js || true",
    "publish:scip-windows": "vite-node scripts/publish-scip-windows.ts",
    "release:npm": "vite-node scripts/release-npm.ts",
    "release:npm:dry-run": "vite-node scripts/release-npm.ts --dry-run"
  },
  "keywords": [
    "scip",
