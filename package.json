{
  "name": "scip-query",
  "version": "0.3.5",
  "description": "Language-agnostic code intelligence CLI powered by SCIP indexes",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "scip-query": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "skills/**/SKILL.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./queries": {
      "import": "./dist/queries/index.js",
      "types": "./dist/queries/index.d.ts"
    },
    "./queries/*": {
      "import": "./dist/queries/*.js",
      "types": "./dist/queries/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build",
    "postinstall": "node dist/postinstall.js || true"
  },
  "keywords": [
    "scip",
    "code-intelligence",
    "code-navigation",
    "go-to-definition",
    "find-references",
    "dead-code",
    "dependency-graph",
    "sourcegraph",
    "typescript",
    "python",
    "rust",
    "java",
    "ruby",
    "php",
    "csharp"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "commander": "^13.1.0",
    "ignore": "^7.0.3"
  },
  "devDependencies": {
    "@sourcegraph/scip-typescript": "^0.4.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
